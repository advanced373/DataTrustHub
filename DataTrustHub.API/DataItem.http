@DataTrustHub.API_HostAddress = https://localhost:7215

###############################################################################
# DATA ITEM ENDPOINTS (DataTrustHub.Features/DataManagement)
# All endpoints require a bearer token from POST /auth/login
###############################################################################

@Token = paste-a-token-from-auth-login

### Upload a file
POST {{DataTrustHub.API_HostAddress}}/data/upload
Authorization: Bearer {{Token}}
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="file"; filename="example.txt"
Content-Type: text/plain

Example content
--boundary--

### Delete a data item (owner-only soft delete)
# Replace {{DataItemId}} with the dataItemId returned by the upload
DELETE {{DataTrustHub.API_HostAddress}}/data/{{DataItemId}}
Authorization: Bearer {{Token}}

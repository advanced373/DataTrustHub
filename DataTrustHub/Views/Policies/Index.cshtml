@model PolicyListViewModel
@{
    ViewData["Title"] = "Policies";
}

<partial name="_AdminNav" model="@ControllerNames.Policies" />

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 m-0">Policies</h1>
    <a class="btn btn-primary" asp-action="Create" asp-route-organizationId="@Model.SelectedOrganizationId">
        <i class="bi bi-plus-lg"></i> New policy
    </a>
</div>

<form method="get" asp-action="Index" class="row g-2 align-items-center mb-3">
    <div class="col-auto">
        <label for="organizationId" class="col-form-label">Organization</label>
    </div>
    <div class="col-auto">
        <select id="organizationId" name="organizationId" class="form-select" onchange="this.form.submit()">
            <option value="">All organizations</option>
            @foreach (var organization in Model.Organizations)
            {
                <option value="@organization.Id" selected="@(organization.Id == Model.SelectedOrganizationId)">@organization.Name</option>
            }
        </select>
    </div>
</form>

<partial name="_ListError" model="Model.ErrorMessage" />

@if (Model.Items.Count == 0 && Model.ErrorMessage is null)
{
    <p class="text-muted">No policies here yet.</p>
}
else if (Model.Items.Count > 0)
{
    <div class="card shadow-sm">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Name</th>
                    <th>Organization</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var policy in Model.Items)
                {
                    <tr>
                        <td>@policy.Name</td>
                        <td>@policy.OrganizationName</td>
                        <td class="text-end">
                            <partial name="_DeleteButton" model="@(new DeleteButtonModel(policy.Id, $"Delete the policy \"{policy.Name}\"?"))" />
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

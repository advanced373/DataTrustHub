{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Issuer": "DataTrustHub",
    "Audience": "DataTrustHub",
    "ExpiryMinutes": 60
  },
  "Registration": {
    "PendingRequestLifetimeDays": 14,
    "PermitsPerHourPerIp": 5,
    "MaxPendingRequests": 100
  },
  "AllowedHosts": "*"
}

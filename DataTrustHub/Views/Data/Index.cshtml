@model ListViewModel<DataTrustHub.Services.Api.DataItemResponse>
@{
    ViewData["Title"] = "My data";
}

<div class="d-flex justify-content-between align-items-center mb-1">
    <h1 class="h3 m-0">My data</h1>
    <a class="btn btn-primary" asp-action="Upload"><i class="bi bi-cloud-upload"></i> Upload</a>
</div>
<p class="text-muted mb-4">Your own files, plus the classified files your clearances give you access to.</p>

<partial name="_ListError" model="Model.ErrorMessage" />

@if (Model.Items.Count == 0 && Model.ErrorMessage is null)
{
    <div class="card shadow-sm">
        <div class="card-body text-center py-5">
            <i class="bi bi-folder2-open display-5 text-muted"></i>
            <p class="mt-3 mb-0 text-muted">No files yet. Upload one, or ask an administrator for a clearance.</p>
        </div>
    </div>
}
else if (Model.Items.Count > 0)
{
    <div class="card shadow-sm">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Name</th>
                    <th class="text-end">Size</th>
                    <th>Classification</th>
                    <th>Policy</th>
                    <th>Owner</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td><i class="bi bi-file-earmark"></i> @item.Name</td>
                        <td class="text-end text-nowrap">@FormatSize(item.Size)</td>
                        <td><partial name="_ClassificationBadge" model="item" /></td>
                        <td>@(item.PolicyName ?? "—")</td>
                        <td>@(item.IsOwner ? "You" : item.OwnerEmail)</td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Download" asp-route-id="@item.Id">
                                <i class="bi bi-download"></i> Download
                            </a>
                            @if (item.CanDelete)
                            {
                                <partial name="_DeleteButton" model="@(new DeleteButtonModel(item.Id, $"Delete \"{item.Name}\"? Nobody will be able to see it any more."))" />
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@functions {
    private static readonly string[] Units = ["B", "KB", "MB", "GB"];

    private static string FormatSize(long bytes)
    {
        double size = bytes;
        var unit = 0;
        while (size >= 1024 && unit < Units.Length - 1)
        {
            size /= 1024;
            unit++;
        }
        return unit == 0 ? $"{bytes} B" : $"{size:0.#} {Units[unit]}";
    }
}

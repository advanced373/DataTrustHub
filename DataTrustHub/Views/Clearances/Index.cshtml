@model ClearanceListViewModel
@{
    ViewData["Title"] = "Clearances";
}

<partial name="_AdminNav" model="@ControllerNames.Clearances" />

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 m-0">Clearances</h1>
    <a class="btn btn-primary" asp-action="Create" asp-route-userId="@Model.SelectedUserId">
        <i class="bi bi-shield-plus"></i> Grant clearance
    </a>
</div>

<form method="get" asp-action="Index" class="row g-2 align-items-center mb-3">
    <div class="col-auto">
        <label for="userId" class="col-form-label">User</label>
    </div>
    <div class="col-auto">
        <select id="userId" name="userId" class="form-select" onchange="this.form.submit()">
            <option value="">All users</option>
            @foreach (var user in Model.Users)
            {
                <option value="@user.Id" selected="@(user.Id == Model.SelectedUserId)">@user.Email</option>
            }
        </select>
    </div>
</form>

<partial name="_ListError" model="Model.ErrorMessage" />

@if (Model.Items.Count == 0 && Model.ErrorMessage is null)
{
    <p class="text-muted">No clearances here yet. Grant one to give a user access under a policy.</p>
}
else if (Model.Items.Count > 0)
{
    <div class="card shadow-sm">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>User</th>
                    <th>Policy</th>
                    <th>Level</th>
                    <th>Name</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var clearance in Model.Items)
                {
                    <tr>
                        <td>@clearance.UserEmail</td>
                        <td>@clearance.PolicyLabel</td>
                        <td><span class="badge text-bg-warning">@clearance.LevelName</span> <span class="small text-muted">(@clearance.LevelPriority)</span></td>
                        <td class="small text-muted">@clearance.Name</td>
                        <td class="text-end">
                            <partial name="_DeleteButton" model="@(new DeleteButtonModel(clearance.Id, $"Revoke the {clearance.LevelName} clearance of {clearance.UserEmail} on {clearance.PolicyLabel}?"))" />
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

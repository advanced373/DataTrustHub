<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- A Db* or domain member the mappers do not map is a build error, so the two models cannot drift apart -->
    <WarningsAsErrors>$(WarningsAsErrors);RMG012;RMG020</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.14" />
    <!-- Microsoft.Data.SqlClient 6.1.7 brings in Pkcs 9.0.11 (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7);
         this lifts it to a patched version. Remove it once SqlClient depends on a patched Pkcs -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    <!-- Source generator: compile-time only, nothing ships at runtime (ADR-0012) -->
    <PackageReference Include="Riok.Mapperly" Version="4.3.1" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DataTrustHub.Domain\DataTrustHub.Domain.csproj" />
    <ProjectReference Include="..\DataTrustHub.SharedKernel\DataTrustHub.SharedKernel.csproj" />
  </ItemGroup>

</Project>

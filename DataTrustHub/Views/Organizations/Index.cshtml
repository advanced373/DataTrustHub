@model ListViewModel<DataTrustHub.Services.Api.OrganizationResponse>
@{
    ViewData["Title"] = "Organizations";
}

<partial name="_AdminNav" model="@ControllerNames.Organizations" />

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 m-0">Organizations</h1>
    <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg"></i> New organization</a>
</div>

<partial name="_ListError" model="Model.ErrorMessage" />

@if (Model.Items.Count == 0 && Model.ErrorMessage is null)
{
    <p class="text-muted">No organizations yet. Create one, then appoint its first organization admin.</p>
}
else if (Model.Items.Count > 0)
{
    <div class="card shadow-sm">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Name</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var organization in Model.Items)
                {
                    <tr>
                        <td>@organization.Name</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-secondary" asp-action="@nameof(DataTrustHub.Controllers.OrganizationsController.AppointAdmin)" asp-route-id="@organization.Id">
                                <i class="bi bi-person-gear"></i> Appoint admin
                            </a>
                            <partial name="_DeleteButton" model="@(new DeleteButtonModel(organization.Id, $"Delete the organization \"{organization.Name}\"?"))" />
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@model AuditTrailViewModel
@* The audit trail table shared by the organization and the platform pages, the newest audit record first *@

<partial name="_ListError" model="Model.ErrorMessage" />

@if (Model.Records.Count == 0 && Model.RecordsLoaded)
{
    <div class="card shadow-sm">
        <div class="card-body text-center py-5">
            <i class="bi bi-journal-check display-5 text-muted"></i>
            <p class="mt-3 mb-0 text-muted">
                @(Model.Filter.IsActive ? "No audit records match the filters." : "No audit records here yet.")
            </p>
        </div>
    </div>
}
else if (Model.Records.Count > 0)
{
    <div class="card shadow-sm">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Time</th>
                    <th>User</th>
                    <th>Action</th>
                    <th>Target</th>
                    <th>Outcome</th>
                    <th>Error code</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var record in Model.Records)
                {
                    <tr>
                        <td class="small text-nowrap">@record.OccurredAt</td>
                        <td>@record.User</td>
                        <td>@record.Action</td>
                        <td class="small">
                            @record.TargetType
                            @if (record.TargetShortId is not null)
                            {
                                <code title="@record.TargetId">@record.TargetShortId</code>
                            }
                        </td>
                        <td><span class="badge @record.OutcomeBadgeClass">@record.Outcome</span></td>
                        <td class="small">
                            @if (record.ErrorCode is not null)
                            {
                                <code>@record.ErrorCode</code>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.IsTruncated)
    {
        <p class="small text-muted mt-2">@string.Format(Messages.AuditTrailTruncated, AuditTrailDisplay.MaxRecords)</p>
    }
}

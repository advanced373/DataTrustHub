@{
    ViewData["Title"] = "Administration";
}

<h1 class="h3 mb-4">Administration</h1>

<div class="list-group shadow-sm">
    <a class="list-group-item list-group-item-action py-3" asp-action="CreateAccount">
        <i class="bi bi-person-plus"></i> Create account
        <div class="small text-muted">Add a user who can sign in to DataTrustHub.</div>
    </a>
    <a class="list-group-item list-group-item-action py-3" asp-action="CreatePolicy">
        <i class="bi bi-file-earmark-lock"></i> Create policy
        <div class="small text-muted">Define a data access policy for an organization.</div>
    </a>
    <a class="list-group-item list-group-item-action py-3" asp-action="CreateGroup">
        <i class="bi bi-people"></i> Create group
        <div class="small text-muted">Group users together.</div>
    </a>
</div>

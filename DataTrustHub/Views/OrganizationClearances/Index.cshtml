@using DataTrustHub.Controllers
@model ClearancesViewModel
@{
    ViewData["Title"] = "Clearances";
    var isFiltered = Model.SelectedUserId is not null || Model.SelectedPolicyId is not null;
}

<partial name="_OrganizationNav" model="@(new OrganizationNavModel(Model.OrganizationId, ControllerNames.OrganizationClearances))" />

<div class="d-flex justify-content-between align-items-center mb-1">
    <h1 class="h3 m-0">Clearances@(Model.OrganizationName is null ? "" : $" of {Model.OrganizationName}")</h1>
    <a class="btn btn-primary" asp-action="@nameof(OrganizationClearancesController.Grant)" asp-route-organizationId="@Model.OrganizationId">
        <i class="bi bi-shield-plus"></i> Grant clearance
    </a>
</div>
<p class="text-muted mb-4">
    A clearance gives a member access to one policy, up to its classification level.
    <a asp-controller="@ControllerNames.MyOrganizations" asp-action="@nameof(MyOrganizationsController.Index)">Back to my organizations</a>
</p>

@* Only ids go in the query string, never an email (ADR-0019) *@
<form method="get" asp-action="@nameof(OrganizationClearancesController.Index)" asp-route-organizationId="@Model.OrganizationId"
      class="row g-2 align-items-center mb-3">
    <div class="col-auto">
        <label for="userId" class="col-form-label">Member</label>
    </div>
    <div class="col-auto">
        <select id="userId" name="userId" class="form-select" onchange="this.form.submit()">
            <option value="">All members</option>
            @foreach (var member in Model.Members)
            {
                <option value="@member.UserId" selected="@(member.UserId == Model.SelectedUserId)">@member.Email</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <label for="policyId" class="col-form-label">Policy</label>
    </div>
    <div class="col-auto">
        <select id="policyId" name="policyId" class="form-select" onchange="this.form.submit()">
            <option value="">All policies</option>
            @foreach (var policy in Model.Policies)
            {
                <option value="@policy.Id" selected="@(policy.Id == Model.SelectedPolicyId)">@policy.Name</option>
            }
        </select>
    </div>
</form>

@if (Model.Clearances.Count == 0)
{
    <div class="card shadow-sm">
        <div class="card-body text-center py-5">
            <i class="bi bi-shield-lock display-5 text-muted"></i>
            <p class="mt-3 mb-0 text-muted">
                @(isFiltered ? "No clearances match the filters." : "No clearances here yet. Grant one to give a member access under a policy.")
            </p>
        </div>
    </div>
}
else
{
    <div class="card shadow-sm">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Member</th>
                    <th>Policy</th>
                    <th>Classification level</th>
                    <th>Name</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var clearance in Model.Clearances)
                {
                    <tr>
                        <td>@clearance.MemberEmail</td>
                        <td>@clearance.PolicyName</td>
                        <td><span class="badge text-bg-warning">@clearance.LevelName</span> <span class="small text-muted">(@clearance.LevelPriority)</span></td>
                        <td class="small text-muted">@clearance.Name</td>
                        <td class="text-end text-nowrap">
                            <form asp-action="@nameof(OrganizationClearancesController.Revoke)" asp-route-organizationId="@Model.OrganizationId" asp-route-clearanceId="@clearance.Id"
                                  method="post" class="d-inline" onsubmit="return confirm(this.dataset.confirm);"
                                  data-confirm="@($"Revoke the {clearance.LevelName} clearance of {clearance.MemberEmail} on {clearance.PolicyName}?")">
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Revoke">
                                    <i class="bi bi-shield-x"></i> Revoke
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

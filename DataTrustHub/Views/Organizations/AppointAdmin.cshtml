@using DataTrustHub.Controllers
@model AppointOrganizationAdminViewModel
@{
    ViewData["Title"] = "Appoint organization admin";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h3 mb-1">Appoint organization admin</h1>
                <p class="text-muted mb-4">
                    The first organization admin of @Model.OrganizationName. They then add the members and appoint further organization admins.
                </p>
                <form asp-action="@nameof(OrganizationsController.AppointAdmin)" asp-route-id="@Model.OrganizationId" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <div class="form-floating mb-3">
                        <input asp-for="Email" class="form-control" autocomplete="off" placeholder="name@example.com" />
                        <label asp-for="Email"></label>
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <button type="submit" class="btn btn-primary">Appoint</button>
                    <a class="btn btn-link" asp-action="@nameof(OrganizationsController.Index)">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

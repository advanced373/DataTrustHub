@model ListViewModel<DataTrustHub.Services.Api.AccountResponse>
@{
    ViewData["Title"] = "Users";
    var currentEmail = User.Identity?.Name;
}

<partial name="_AdminNav" model="@ControllerNames.Users" />

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 m-0">Users</h1>
    <a class="btn btn-primary" asp-action="Create"><i class="bi bi-person-plus"></i> New user</a>
</div>

<partial name="_ListError" model="Model.ErrorMessage" />

@if (Model.Items.Count > 0)
{
    <div class="card shadow-sm">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Email</th>
                    <th>Role</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var account in Model.Items)
                {
                    var isCurrentUser = string.Equals(account.Email, currentEmail, StringComparison.OrdinalIgnoreCase);
                    <tr>
                        <td>
                            @account.Email
                            @if (isCurrentUser)
                            {
                                <span class="badge text-bg-light border ms-1">you</span>
                            }
                        </td>
                        <td>
                            <span class="badge @(account.Role == Constants.AdminRole ? "text-bg-primary" : "text-bg-secondary")">@account.Role</span>
                        </td>
                        <td class="text-end">
                            @* The API refuses to delete your own account, so the button is not offered *@
                            @if (!isCurrentUser)
                            {
                                <partial name="_DeleteButton" model="@(new DeleteButtonModel(account.Id, $"Delete {account.Email}? Their clearances are removed and their data is deleted."))" />
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

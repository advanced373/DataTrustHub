@using DataTrustHub.Controllers
@model AddMemberViewModel
@{
    ViewData["Title"] = "Add member or guest";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h3 mb-1">Add member or guest</h1>
                <p class="text-muted mb-4">To @Model.OrganizationName. Enter the exact email address of their account.</p>
                <form asp-action="@nameof(MyOrganizationsController.AddMember)" asp-route-organizationId="@Model.OrganizationId" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <div class="form-floating mb-3">
                        <input asp-for="Email" class="form-control" autocomplete="off" placeholder="name@example.com" />
                        <label asp-for="Email"></label>
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Role" class="form-label"></label>
                        <select asp-for="Role" class="form-select">
                            @foreach (var role in MembershipRoles.Addable)
                            {
                                <option value="@role">@MembershipRoles.LabelOf(role)</option>
                            }
                        </select>
                        <div class="form-text">A guest is an external person. The guest role is fixed.</div>
                        <span asp-validation-for="Role" class="text-danger"></span>
                    </div>
                    <button type="submit" class="btn btn-primary">Add</button>
                    <a class="btn btn-link" asp-action="@nameof(MyOrganizationsController.Members)" asp-route-organizationId="@Model.OrganizationId">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
